#!/usr/bin/env bash
# orch-box — run the orchestrator squad FULL-AUTO inside a Docker container.
#
# The container (namespaces + cgroups + Docker's default seccomp-BPF profile) is
# the isolation boundary, so the agents can run with no permission prompts
# (claude --dangerously-skip-permissions / codex --dangerously-bypass-...) without
# touching the host: only the chosen workspace directory is mounted, and the host
# filesystem is otherwise invisible. Credentials are *copied* in (not bind-mounted)
# so token refreshes stay inside the container and never write back to the host.
#
# Usage:
#   orch-box build                 # build the image (first run / after changes)
#   orch-box up [DIR]              # start the box on DIR (default: $PWD) and bring up the squad
#   orch-box attach               # attach to the tmux layout (lands on the human pane)
#   orch-box status               # show session/pane state
#   orch-box tell <role> <msg…>   # dispatch (also: say / broadcast)
#   orch-box sh                   # shell into the container (debug)
#   orch-box down                 # tear down the squad AND remove the container
#
# Residual risk: the container has outbound network (the agents need it to reach
# their APIs), so an agent could still reach arbitrary hosts. Filesystem blast
# radius is limited to the mounted workspace. Add egress policy (Tetragon/Falco)
# if you need to constrain the network too.
set -euo pipefail

IMAGE="orch-box:latest"
NAME="orch-box"
REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
WORKDIR_IN=/work
# orch's own metadata (config.toml + conductor.md) lives HERE, inside the container
# only — never in the mounted workspace. This keeps the user's project untouched
# (no .orch/ written into it, nothing of theirs clobbered).
ORCH_DIR_IN=/opt/orchbox/.orch

die() { echo "orch-box: $*" >&2; exit 1; }
have_image()    { docker image inspect "$IMAGE" >/dev/null 2>&1; }
container_id()  { docker ps -aq -f "name=^${NAME}$"; }
running()       { [ -n "$(docker ps -q -f "name=^${NAME}$")" ]; }
need_running()  { running || die "box not running (run: orch-box up)"; }
dexec()         { docker exec -w "$WORKDIR_IN" "$NAME" "$@"; }
dexec_it()      { docker exec -it -w "$WORKDIR_IN" "$NAME" "$@"; }

cmd_build() {
  echo "orch-box: building $IMAGE (this installs claude + codex + tmux + orch)…"
  docker build -t "$IMAGE" -f "$REPO_ROOT/docker/Dockerfile" "$REPO_ROOT"
}

# Generate the FULL-AUTO config inside the box, in the container-local ORCH_DIR_IN
# (never in the mounted workspace). conductor.md comes from `orch init`; we then
# overwrite config.toml so every agent launches with prompts disabled.
write_fullauto_config() {
  # ORCH_DIR is set on the container, so `orch init` writes to ORCH_DIR_IN.
  dexec sh -c 'orch init --force >/dev/null 2>&1 || true'
  # `docker exec -i` is REQUIRED: without it stdin is closed and the heredoc never
  # reaches `cat`, leaving an empty config.toml (→ all panes fall back to a shell).
  # Unquoted heredoc so $ORCH_DIR_IN expands here; \$(...) stays literal for the pane.
  docker exec -i "$NAME" sh -c "cat > $ORCH_DIR_IN/config.toml" <<TOML
# FULL-AUTO config — generated by orch-box, container-local. Every agent runs with
# permission prompts DISABLED. Safe only because this runs inside the box.
[session]
name = "orch"

[orchestrator]
launch = 'claude --dangerously-skip-permissions --append-system-prompt "\$(cat $ORCH_DIR_IN/conductor.md)"'

[worker1]
launch = "claude --dangerously-skip-permissions --model opus"

[worker2]
launch = "codex --dangerously-bypass-approvals-and-sandbox --model gpt-5.5 -c model_reasoning_effort=high"

[worker3]
launch = "claude --dangerously-skip-permissions --model sonnet"

[human]
launch = ""
TOML
}

copy_credentials() {
  dexec sh -c 'mkdir -p /root/.claude /root/.codex'
  local copied=0
  if [ -f "$HOME/.claude/.credentials.json" ]; then
    docker cp "$HOME/.claude/.credentials.json" "$NAME:/root/.claude/.credentials.json"; copied=1
  fi
  [ -f "$HOME/.claude.json" ] && docker cp "$HOME/.claude.json" "$NAME:/root/.claude.json"
  if [ -f "$HOME/.codex/auth.json" ]; then
    docker cp "$HOME/.codex/auth.json" "$NAME:/root/.codex/auth.json"; copied=1
  fi
  docker exec "$NAME" sh -c 'chmod 600 /root/.claude/.credentials.json /root/.codex/auth.json 2>/dev/null || true'
  [ "$copied" = 1 ] || echo "orch-box: WARNING — no credentials found to copy; agents may need login inside the box." >&2
}

# Pre-accept the one-time "trust this folder?" prompts for the workspace so the
# agents start unattended. --dangerously-skip-permissions skips per-tool prompts
# but NOT the initial workspace-trust dialog; claude tracks trust per project in
# ~/.claude.json, codex in ~/.codex/config.toml.
seed_trust() {
  docker exec "$NAME" node -e '
    const fs=require("fs"), f="/root/.claude.json", dir=process.argv[1];
    let c={}; try{ c=JSON.parse(fs.readFileSync(f,"utf8")) }catch(e){}
    c.bypassPermissionsModeAccepted=true;   // skip the one-time "Bypass Permissions mode" dialog
    c.projects=c.projects||{};
    c.projects[dir]=Object.assign({allowedTools:[],projectOnboardingSeenCount:1},
                                  c.projects[dir]||{}, {hasTrustDialogAccepted:true});
    fs.writeFileSync(f, JSON.stringify(c));
  ' "$WORKDIR_IN" 2>/dev/null || true
  docker exec "$NAME" sh -c \
    'mkdir -p /root/.codex && printf "[projects.\"%s\"]\ntrust_level = \"trusted\"\n" "$1" > /root/.codex/config.toml' \
    sh "$WORKDIR_IN"
}

# claude shows a one-time "Bypass Permissions mode — Yes, I accept" dialog per
# session that config can't pre-dismiss. Poll each claude pane and auto-select
# "Yes, I accept" (Down, Enter). codex (YOLO mode) has no such gate.
accept_bypass_dialogs() {
  local role id tries
  for role in orchestrator worker1 worker3; do
    id=$(docker exec "$NAME" tmux list-panes -s -t orch -F '#{pane_id} #{@orch_role}' \
         | awk -v r="$role" '$2==r{print $1}')
    [ -n "$id" ] || continue
    tries=0
    while [ "$tries" -lt 30 ]; do
      # -J joins wrapped lines so the accept text isn't split in narrow panes.
      if docker exec "$NAME" tmux capture-pane -p -J -t "$id" | grep -q "Yes, I accept"; then
        docker exec "$NAME" tmux send-keys -t "$id" Down
        sleep 0.3
        docker exec "$NAME" tmux send-keys -t "$id" Enter
        sleep 0.9
        # Confirm it took; if the dialog is still up, loop and resend.
        docker exec "$NAME" tmux capture-pane -p -J -t "$id" | grep -q "Yes, I accept" || break
      fi
      sleep 0.5; tries=$((tries + 1))
    done
  done
}

cmd_up() {
  local dir="${1:-$PWD}"
  dir="$(cd "$dir" && pwd)" || die "no such dir: $1"
  have_image || cmd_build
  running && die "box already running (orch-box attach / orch-box down)"
  # Remove any stopped leftover container of the same name.
  [ -n "$(container_id)" ] && docker rm -f "$NAME" >/dev/null
  echo "orch-box: starting container on $dir → $WORKDIR_IN"
  # IS_SANDBOX=1 tells Claude Code this is an externally-sandboxed environment, so
  # it allows --dangerously-skip-permissions to run as root inside the container
  # (it refuses as root otherwise). The container IS that sandbox.
  docker run -d --name "$NAME" \
    --hostname orch-box \
    -e IS_SANDBOX=1 \
    -e ORCH_DIR="$ORCH_DIR_IN" \
    -v "$dir:$WORKDIR_IN" \
    -w "$WORKDIR_IN" \
    "$IMAGE" sleep infinity >/dev/null
  copy_credentials
  seed_trust
  write_fullauto_config
  echo "orch-box: bringing up the squad…"
  dexec orch up
  echo "orch-box: accepting one-time agent dialogs…"
  accept_bypass_dialogs
  echo
  echo "orch-box: ready. Attach with:  orch-box attach"
  echo "          (you'll land on the human pane; type: orch say \"…\")"
}

cmd_attach() {
  need_running
  # Attach straight to the running tmux session; lands on the active (human) pane.
  dexec_it tmux attach -t orch
}

cmd_passthru() { need_running; dexec orch "$@"; }

cmd_sh() { need_running; dexec_it bash; }

cmd_down() {
  if running; then
    dexec orch down >/dev/null 2>&1 || true
    # Files were created by root inside the container; hand the workspace back to
    # the host user so the project isn't littered with root-owned files.
    docker exec "$NAME" chown -R "$(id -u):$(id -g)" "$WORKDIR_IN" 2>/dev/null || true
  fi
  if [ -n "$(container_id)" ]; then
    docker rm -f "$NAME" >/dev/null
    echo "orch-box: container removed (workspace ownership restored to $(id -un))"
  else
    echo "orch-box: not running"
  fi
}

usage() { sed -n '2,30p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; }

main() {
  [ $# -ge 1 ] || { usage; exit 0; }
  local sub="$1"; shift || true
  case "$sub" in
    build)              cmd_build ;;
    up|start)           cmd_up "$@" ;;
    attach)             cmd_attach ;;
    status|ps)          cmd_passthru status ;;
    tell|say|broadcast|all) cmd_passthru "$sub" "$@" ;;
    sh|shell)           cmd_sh ;;
    down|kill)          cmd_down ;;
    help|-h|--help)     usage ;;
    *)                  die "unknown command: $sub (try: orch-box help)" ;;
  esac
}
main "$@"
